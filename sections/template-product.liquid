<link rel="stylesheet" href="https://unpkg.com/swiper@7/swiper-bundle.min.css">
<script src="https://unpkg.com/swiper@7/swiper-bundle.min.js"></script>

{% assign selected_variant = product.selected_or_first_available_variant %}

<style>
  .swiper-button-prev,
  .swiper-button-next {
    color: black;
    top: auto !important;
    height: 20px;
  }
  .swiper-button-prev::after,
  .swiper-button-next::after {
    font-size: 20px;
  }
  .swiper-pagination {
    color: black;
    bottom: 0 !important;
  }
  .swiper-pagination-bullet-active {
    background: black !important;
  }
  .product--information {
    height: fit-content;
  }
</style>

<div class="max-w-6xl mx-auto my-8">
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <div class="product--medias">
      <div class="hidden md:block">
        {% for media in product.media %}
          <div class="p-2 overflow-hidden h-100">
            {% render 'product-media', media: media %}
          </div>
        {% endfor %}
      </div>

      <div class="md:hidden">
        <div class="swiper h-94">
          <div class="swiper-wrapper">
            {% for media in product.media %}
              <div class="swiper-slide">
                <div class="p-2 overflow-hidden h-80">
                  {% render 'product-media', media: media %}
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="swiper-pagination"></div>

          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>
    </div>

    <div class="sticky p-2 product--information top-5">
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'vendor' %}
              <div class="my-3">
                <span class="text-xs text-gray-500">{{ product.vendor }}</span>
              </div>
            {% when 'title' %}
              <div class="my-3">
                <h1 class="text-3xl text-gray-900">{{ product.title }}</h1>
              </div>
            {% when 'price' %}
              <div class="my-3">
                <span class="text-base text-gray-500 line-through">
                  {{- selected_variant.compare_at_price | money -}}
                </span>
                <span class="text-lg text-gray-900">{{ selected_variant.price | money }}</span>

                {% if selected_variant.price < selected_variant.compare_at_price %}
                  <span class="px-5 py-1 mx-4 text-sm font-bold text-white bg-red-500 rounded-full">Sale</span>
                {% endif %}
              </div>
            {% when 'variant_selector' %}
              <div class="my-3">
                {% unless product.has_only_default_variant %}
                  <div data-url="{{ product.url}}" data-section="{{ section.id }}">
                    {% for option in product.options_with_values %}
                      <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>

                      <div class="my-2">
                        <select
                          name="options[{{ option.name | escape }}]"
                          id="Option-{{ section.id }}-{{ forloop.index0 }}"
                          class="w-full px-3 py-3 border"
                        >
                          {% for value in option.values %}
                            <option
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ value }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endfor %}
                  </div>
                {% endunless %}
              </div>

            {% when 'quantity' %}
              <div class="my-3">
                <label for="Quantity-{{ section.id }}">Quantity</label>

                <div class="my-2">
                  <input
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    value="1"
                    min="1"
                    class="w-full px-3 py-3 border"
                  >
                </div>
              </div>
            {% when 'description' %}
              <div class="my-3">
                <p class="text-gray-700">{{ product.description }}</p>
              </div>

            {% when 'image_upload' %}
              <div class="my-3" data-image-upload data-upload-endpoint="{{ block.settings.upload_endpoint }}">
                <label class="block mb-2">{{ block.settings.label }}</label>
                <input
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  data-image-upload-input
                  class="block w-full text-sm"
                >
                <input type="hidden" name="properties[_engraving_image]" data-image-upload-url>
                <p class="mt-2 text-sm" data-image-upload-status></p>
                <img data-image-upload-preview class="hidden mt-3 max-h-48 rounded border">
              </div>

            {% when 'checkout_buttons' %}
              <div class="my-3">
                <button
                  type="submit"
                  name="add"
                  class="w-full px-6 py-4 my-2 text-white bg-gray-900 rounded-sm hover:bg-gray-700"
                  {% if selected_variant.available == false %}
                    disabled
                  {% endif %}
                >
                  {% if selected_variant.available == false %}
                    Sold out
                  {% else %}
                    Add to cart
                  {% endif %}
                </button>
              </div>
            {% else %}

          {% endcase %}
        {% endfor %}
      {% endform %}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-image-upload]').forEach((wrap) => {
    const endpoint = wrap.dataset.uploadEndpoint;
    const fileInput = wrap.querySelector('[data-image-upload-input]');
    const urlInput = wrap.querySelector('[data-image-upload-url]');
    const status = wrap.querySelector('[data-image-upload-status]');
    const preview = wrap.querySelector('[data-image-upload-preview]');
    const form = wrap.closest('form');
    const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
    let previewUrl = null;

    fileInput.addEventListener('change', () => {
      const file = fileInput.files[0];
      urlInput.value = '';
      if (previewUrl) { URL.revokeObjectURL(previewUrl); previewUrl = null; }

      if (!file) {
        preview.classList.add('hidden');
        status.textContent = '';
        return;
      }

      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      preview.classList.remove('hidden');
      status.textContent = 'Ready — image will upload when you add to cart.';
    });

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      const file = fileInput.files[0];
      if (!file) return;
      if (urlInput.value) return;

      e.preventDefault();

      if (!endpoint) {
        status.textContent = 'Upload endpoint not configured.';
        return;
      }

      status.textContent = 'Uploading…';
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData();
      fd.append('image', file);

      try {
        const res = await fetch(endpoint, { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');

        urlInput.value = data.url;
        status.textContent = 'Uploaded ✓ — adding to cart…';
        form.submit();
      } catch (err) {
        status.textContent = 'Error: ' + err.message;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });

  const swiper = new Swiper('.swiper', {
    direction: 'horizontal',

    pagination: {
      el: '.swiper-pagination',
    },

    navigation: {
      prevEl: '.swiper-button-prev',
      nextEl: '.swiper-button-next',
    },
  });
</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_selector",
      "name": "Variant Selector",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "checkout_buttons",
      "name": "Checkout Buttons",
      "limit": 1
    },
    {
      "type": "image_upload",
      "name": "Image Upload",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field label",
          "default": "Upload your image"
        },
        {
          "type": "text",
          "id": "upload_endpoint",
          "label": "Upload endpoint URL",
          "info": "The /upload URL of your Heroku app (or ngrok URL for local testing). Example: https://abc123.ngrok-free.app/upload"
        }
      ]
    }
  ]
}
{% endschema %}
